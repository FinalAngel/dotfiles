#!/usr/bin/env bash
# `dot` handles updates, installation, editing

# exit immediately if a command exits with a non-zero status
set -e

PARENT="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
DIR="$( cd "$( dirname "$PARENT" )" >/dev/null 2>&1 && pwd )"

displayUsageAndExit() {
  echo "dotfiles -- dotfiles management"
  echo ""
  echo "Usage: dotfiles [options]"
  echo ""
  echo "Options:"
  echo "  -e, --edit     Edit dotfiles"
  echo "  -g, --goto     Go to dotfiles directory"
  echo "  -h, --help     Show help"
  echo "  -i, --install  Runs installer"
  echo "  -u, --update   Runs updater"
  echo ""
  exit
}

while test $# -gt 0; do
  case "$1" in
    "-h"|"--help")
      displayUsageAndExit
      ;;
    "-u"|"--update")
      source "$DIR/scripts/update"
      exit
      ;;
    "-i"|"--install")
      source "$DIR/scripts/install"
      exit
      ;;
    "-e"|"--edit")
      # `code` is the GUI editor launcher on the mac. a headless linux box has
      # none, so fall back through $VISUAL/$EDITOR to a terminal editor rather
      # than failing with "command not found"
      for editor in code zed "$VISUAL" "$EDITOR" nvim vim; do
        if [ -n "$editor" ] && type "$editor" > /dev/null 2>&1; then
          exec "$editor" "$DIR"
        fi
      done
      echo "No editor found, set \$EDITOR or \$VISUAL"
      exit 1
      ;;
    "-g"|"--go")
      cd $DIR
      $SHELL
      exit
      ;;
    *)
      echo "Invalid option: $1"
      echo ""
      displayUsageAndExit
      ;;
  esac
  shift
done

# needs an argument
displayUsageAndExit
