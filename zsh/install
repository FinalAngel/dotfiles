#!/usr/bin/env bash
source "$DIR/utils/index"

info "Setup \033[0;37m[zsh]\033[0m"

# the oh-my-zsh installer bails out when zsh itself is missing, which under
# `set -e` takes the whole run down with it. homebrew provides zsh on macOS;
# on linux it comes from the distribution
require_package "zsh" || return 0

# create the machine-local secrets file (never part of the repo)
if [ ! -f "$HOME/.localrc" ]; then
  printf '# machine-local secrets and env vars — never committed, sourced by zshrc\n' > "$HOME/.localrc"
  success "Created empty ~/.localrc"
fi

if [ ! -d "$HOME/.oh-my-zsh" ];then
  # run installation script
  export RUNZSH=no
  export CHSH=no
  export KEEP_ZSHRC=yes
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"

  success "Oh-my-zsh successfully installed"
else
  success "Oh-my-zsh already setup"
fi
