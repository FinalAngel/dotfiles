# https://starship.rs/config/

# don't print a new line at the start of the prompt
add_newline = false

# default 30ms is too tight for directories with iCloud-backed symlinks
scan_timeout = 100

# default 500ms is too tight for `node --version`. fnm's node is a 108MB
# Developer-ID signed binary, so the first exec after a boot pays a full
# codesign verification and starship drops the module with a [WARN]
command_timeout = 2000
