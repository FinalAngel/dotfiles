#!/bin/zsh
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.dotfiles/zsh"
export ZSH_THEME="" # make sure no theme is set
export PROJECTS=$CODE_DIR # your project folder that we can `c [tab]` to
export STARSHIP_CONFIG=~/.starship # for customisations
export HIST_STAMPS="dd/mm/yyyy"

# stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts
if [ -f "$HOME/.localrc" ]; then
  source "$HOME/.localrc"
fi

# double check that it is safe to load zsh initialisation
if [ -d "$HOME/.oh-my-zsh" ]; then
  # define plugins first
  plugins=(brew docker git git-extras npm python)
  # updates are handled by `dotfiles -u`, skip the periodic check
  zstyle ':omz:update' mode disabled
  # skip the completion-directory permission audit
  ZSH_DISABLE_COMPFIX=true
  # if yes load standard initialisations script
  source $ZSH/oh-my-zsh.sh
  # load additional plugins
  # (missing until homebrew has installed them; HOMEBREW_PREFIX avoids
  # forking `brew --prefix` on every shell start)
  BREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
  [ -f "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && \
    source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  [ -f "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && \
    source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  unset BREW_PREFIX
fi

# disable any beeping
unsetopt BEEP
# don't print "%"
unsetopt prompt_cr prompt_sp

# fixes slow copy & paste
zstyle ':bracketed-paste-magic' active-widgets '.self-*'

# initialise the shell tools. each one is guarded because on a fresh machine
# the shell is used before (and while) homebrew installs them — an unguarded
# eval turns every new terminal into a "command not found" error
command -v starship > /dev/null && eval "$(starship init zsh)" # theme, needs to be at the end
command -v direnv   > /dev/null && eval "$(direnv hook zsh)"
command -v fnm      > /dev/null && eval "$(fnm env --use-on-cd --shell zsh)" # respects .nvmrc / .node-version on cd
command -v fzf      > /dev/null && eval "$(fzf --zsh)"

# local user binaries
export PATH="$HOME/.local/bin:$PATH"

# bun (if installed)
if [ -d "$HOME/.bun" ]; then
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
  [ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"
fi

# lm studio (if installed)
[ -d "$HOME/.lmstudio/bin" ] && export PATH="$PATH:$HOME/.lmstudio/bin"

