#!/usr/bin/env bash
source "$DIR/utils/index"

info "Setup \033[0;37m[node]\033[0m"

if ! is_executable "fnm"; then
  fail_hard "fnm is not installed, run the homebrew setup first!"
fi

# make fnm available within this script
eval "$(fnm env)"

fnm_install () {
  if fnm list | grep -q "v$1\."; then
    success "Node $1 already installed"
  else
    fnm install "$1" > /dev/null 2>&1
    success "Installed Node $1"
  fi
}

# install declared versions
fnm_install 22
fnm_install 24

# set and use the default version
fnm default 22
fnm use default

npm_install () {
  if npm list -g "$1" > /dev/null 2>&1; then
    success "Npm package $1 already installed"
  else
    npm install "$1" -g --loglevel=silent
    success "Installed npm package $1"
  fi
}

# install npm packages globally
npm_install "npm-check-updates"
npm_install "typescript"

# run updates
source "$DIR/node/update"
