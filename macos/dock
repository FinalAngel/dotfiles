#!/usr/bin/env bash
source "$DIR/utils/index"

# applies the Dock layout stored in macos/Dockfile
# (regenerate the file from the current Dock with macos/dock-dump)
DOCKFILE="$DIR/macos/Dockfile"

if [ ! -f "$DOCKFILE" ]; then
  info "No Dockfile found, skipping dock setup"
else
  dockutil --no-restart --remove all > /dev/null 2>&1

  while read -r item; do
    case "$item" in
      ''|'#'*) continue ;;
      spacer)
        dockutil --no-restart --add '' --type spacer --section apps > /dev/null
        ;;
      folder:*)
        target="${item#folder:}"
        target="${target/#\~/$HOME}"
        dockutil --no-restart --add "$target" --view grid --display folder > /dev/null
        ;;
      *)
        app="${item/#\~/$HOME}"
        if [ -e "$app" ]; then
          dockutil --no-restart --add "$app" > /dev/null
        else
          info "Dock item not installed, skipped: $item"
        fi
        ;;
    esac
  done < "$DOCKFILE"

  # launchd normally relaunches the Dock right after the kill, but it can
  # fail to come back when killed mid-plist-update — kick it if it didn't
  killall Dock
  sleep 2
  if ! pgrep -qx Dock; then
    launchctl kickstart "gui/$(id -u)/com.apple.Dock.agent"
  fi
  success "Dock successfully configured"
fi
