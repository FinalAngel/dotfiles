#!/usr/bin/env bash
source "$DIR/utils/index"

info "Update \033[0;37m[macOS]\033[0m"

# no-op when scripts/update already asked for the password
require_sudo

# apply the canonical Dock layout from the repo — the Dockfile is curated,
# never auto-dumped (a dump would clobber the other machine's layout);
# to record a rearranged Dock into the repo, run macos/dock-dump manually
source "$DIR/macos/dock"

# update software — must run via sudo, otherwise softwareupdate asks for
# the password itself (twice) and ignores the cached sudo credentials
if sudo softwareupdate --install --all --force; then
  success "Updated software, this might need a reboot"
else
  warn "Some system updates could not be installed, see the output above"
fi

# no ruby/gem management here on purpose: nothing in these dotfiles owns a ruby
# toolchain. homebrew's ruby is only present as a tmuxinator dependency and is
# managed by homebrew, and bin/git-rank and bin/git-wtf run on the system ruby
