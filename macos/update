#!/usr/bin/env bash
source "$DIR/utils/index"

info "Update \033[0;37m[macOS]\033[0m"

# store the current Dock layout in the repo so it syncs across laptops
source "$DIR/macos/dock-dump"

# update software — must run via sudo, otherwise softwareupdate asks for
# the password itself (twice) and ignores the cached sudo credentials
require_sudo
sudo softwareupdate --install --all --force
success "Updated software, this might need a reboot"

# update gem files
require_sudo
sudo gem update --system > /dev/null 2>&1
success "Updated gems"
