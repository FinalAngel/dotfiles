#!/usr/bin/env bash
source "$DIR/utils/index"

# manual authoring aid: overwrites macos/Dockfile with THIS machine's current
# Dock layout. The Dockfile is canonical and applied on every machine by
# 'dotfiles -u' (macos/dock), so only run this when this machine's Dock is
# the layout you want everywhere — it replaces whatever is in the file
DOCKFILE="$DIR/macos/Dockfile"

if ! is_executable "dockutil"; then
  info "dockutil not installed, skipping dock dump"
else
  {
    echo "# Canonical Dock layout — applied by 'dotfiles -u' (macos/dock)"
    echo "# edit by hand or overwrite with macos/dock-dump; missing apps are skipped"
    # cut preserves empty fields, unlike read with a tab IFS
    dockutil --list | while IFS= read -r line; do
      url="$(printf '%s' "$line" | cut -f2)"
      section="$(printf '%s' "$line" | cut -f3)"
      if [ "$section" = "persistentApps" ]; then
        if [ -z "$url" ]; then
          echo "spacer"
        else
          path="$(python3 -c 'import sys, urllib.parse as u; print(u.unquote(sys.argv[1]))' "${url#file://}")"
          path="${path%/}"
          # normalize cryptex paths (e.g. Safari) to their visible location
          path="${path#/System/Volumes/Preboot/Cryptexes/App}"
          if [ ! -e "$path" ] && [ -e "/Applications/$(basename "$path")" ]; then
            path="/Applications/$(basename "$path")"
          fi
          echo "${path/#$HOME/\~}"
        fi
      elif [ "$section" = "persistentOthers" ] && [ -n "$url" ]; then
        path="$(python3 -c 'import sys, urllib.parse as u; print(u.unquote(sys.argv[1]))' "${url#file://}")"
        path="${path%/}"
        echo "folder:${path/#$HOME/\~}"
      fi
    done
  } > "$DOCKFILE"

  success "Dock layout stored in Dockfile"
fi
