#!/usr/bin/env bash
declare PARENT="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
declare DIR="$( cd "$( dirname "$PARENT" )" >/dev/null 2>&1 && pwd )"

# load utilities
source "$DIR/utils/index"

# ask for the password up front — rosetta, homebrew casks, FileVault and the
# hosts symlink all need it later on, and a prompt appearing mid-run reads as a
# hang. linux asks later and only if it has to: the one step that needs sudo
# there is installing missing packages, which is a no-op on every run after the
# first, so asking up front would be a password prompt for nothing
if is_macos; then
  require_sudo
fi

# universal installs. the macOS-only topics among these (homebrew, zed, iterm2,
# fonts) guard themselves and report a skip on linux, rather than being left out
# of the list here — the order matters, homebrew has to run before node and
# python pick up fnm and uv
source "$DIR/system/install"
source "$DIR/zsh/install"
source "$DIR/vim/install"
source "$DIR/homebrew/install"
# the linux half of the same provisioning slot: node and python below need fnm
# and uv, which homebrew supplies on macOS. no-op on macOS
source "$DIR/linux/tooling"
source "$DIR/git/install"
source "$DIR/node/install"
source "$DIR/python/install"
source "$DIR/zed/install"
source "$DIR/tmux/install"
source "$DIR/iterm2/install"
source "$DIR/claude/install"
source "$DIR/herdr/install"
source "$DIR/fonts/install"

# system specific installs
source "$DIR/$DOTFILES_OS/install"

info "👉 Installation finished"
echo ""
