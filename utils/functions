#!/usr/bin/env bash
function link_file () {
  local src=$1 dst=$2

  local overwrite= backup= skip=
  local action=

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]
  then

    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then

      local currentSrc="$(readlink $dst)"

      if [ "$currentSrc" == "$src" ]
      then

        skip=true;

      else

        user "File already exists: $dst ($(basename "$src")), what do you want to do?\n\
         [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
        read -n 1 action

        case "$action" in
          o )
            overwrite=true;;
          O )
            overwrite_all=true;;
          b )
            backup=true;;
          B )
            backup_all=true;;
          s )
            skip=true;;
          S )
            skip_all=true;;
          * )
            ;;
        esac

      fi

    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      success "Removed $dst"
    fi

    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      success "Moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]
    then
      success "Skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]  # "false" or empty
  then
    ln -s "$1" "$2"
    success "Linked $1 to $2"
  fi
}

function create_symlinks () {
  local overwrite_all=false backup_all=false skip_all=false

  for src in $(find -H "$DIR" -maxdepth 2 -name "*.symlink" -not -path "*.git*")
  do
    dst="$HOME/.$(basename "${src%.*}")"
    link_file "$src" "$dst"
  done
}

function is_executable() {
  type "$1" > /dev/null 2>&1
}

# Portable replacement for `ln -Fs` / `ln -sfh`. Those flags are BSD-only —
# GNU ln spells the same thing `-n` — so neither set is safe to hardcode in
# files that now run on both platforms. Dropping the destination first behaves
# identically on either ln, including when it is a symlink to a directory.
function force_link() {
  local src="$1" dst="$2"

  if [ -L "$dst" ] || [ -f "$dst" ]; then
    rm -f "$dst"
  fi

  ln -s "$src" "$dst"
}

# Asks for the admin password once and keeps the sudo timestamp alive for the
# rest of the run. Safe to call repeatedly — only the first call prompts.
#
# This matters because steps further down shell out to sudo themselves (cask
# installers, softwareupdate, gem). sudo prints its prompt to the tty even when
# the surrounding command is redirected to /dev/null, so without a cached
# credential the run appears to hang on a context-free "Password:".
function require_sudo() {
  if [ -n "${SUDO_KEEPALIVE_PID:-}" ] && kill -0 "$SUDO_KEEPALIVE_PID" 2>/dev/null; then
    return 0
  fi

  if ! sudo -n true 2>/dev/null; then
    user "Admin privileges are required for this run, please enter your password..."
    sudo -v || fail_hard "Could not obtain admin privileges"
  fi

  # macOS expires the timestamp after 5 minutes, which is shorter than a cask
  # upgrade — refresh it so no later step prompts again mid-run
  while true; do
    sudo -n true 2>/dev/null || exit
    sleep 60
    kill -0 "$$" 2>/dev/null || exit
  done &
  SUDO_KEEPALIVE_PID=$!

  trap release_sudo EXIT
}

function release_sudo() {
  if [ -n "${SUDO_KEEPALIVE_PID:-}" ]; then
    kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
    unset SUDO_KEEPALIVE_PID
  fi
}
