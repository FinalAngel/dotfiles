// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // "soft_wrap": "editor_width",
  "edit_predictions": {
    "mode": "eager"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
      "default_model": "claude-opus-5"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "tool_permissions": {
      "default": "allow"
    },
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-opus-5"
    },
    "default_width": 240
  },
  "buffer_font_family": "Fira Code",
  "buffer_font_size": 15.0,
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 14.0,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "base_keymap": "VSCode",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "terminal": {
    "font_size": 12.0,
    "env": {
      "GIT_EDITOR": "zed --wait"
    }
  },
  "gutter": {
    "line_numbers": true
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 16
  },
  "search": {
    "button": false
  },
  "outline_panel": {
    "dock": "left",
    "default_width": 240
  },
  "git_panel": {
    "dock": "left",
    "default_width": 240
  },
  "format_on_save": "on",
  "lsp_document_colors": "none",
  // Specifying this key replaces Zed's defaults, so the VCS/OS entries
  // below are re-listed rather than inherited.
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/.next",
    "**/.turbo",
    "**/dist",
    "**/build",
    "**/.venv",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache"
  ],
  "languages": {
    "CSS": {
      // "..." keeps Zed's default CSS servers; listing only tailwind
      // would disable vscode-css-language-server.
      "language_servers": ["tailwindcss-language-server", "..."]
    }
  },
  "context_servers": {
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@0.4.0"]
    }
  }
}
