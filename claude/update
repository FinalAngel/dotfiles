#!/usr/bin/env bash
source "$DIR/utils/index"

info "Update \033[0;37m[claude]\033[0m"

# see claude/install — the iCloud backup is macOS only
if ! is_macos; then
  success "No iCloud Drive on $DOTFILES_OS, nothing to back up"
  return 0
fi

if [ -f "$HOME/.claude.json" ] && [ ! -L "$HOME/.claude.json" ]; then
  cp "$HOME/.claude.json" "$SYSTEM_DIR/.claude.json.backup"
  success "Backed up .claude.json to iCloud"
else
  success "Nothing to back up"
fi

# claude-tips teaches commands that Claude Code keeps changing, so compare the
# tip list against the published reference and say what drifted. Reporting only
# — rewriting a tip needs judgement, which is what /claude-tips:refresh is for.
# the plugin is installed from github.com/FinalAngel/claude-tips, so the script
# lives in whichever profile's plugin cache. Newest match wins, so a stale cache
# left behind by an old marketplace can't shadow the current one.
check_tips=$(ls -t "$HOME"/.claude*/plugins/cache/*/claude-tips/*/scripts/check-tips.sh 2>/dev/null | head -1)
if [ -n "$check_tips" ] && [ -x "$check_tips" ]; then
  tips_report=$("$check_tips" 2>&1)
  case $? in
    0) success "Claude tips are current" ;;
    1)
      warn "Claude tips have drifted, run /claude-tips:refresh"
      printf '%s\n' "$tips_report" | sed 's/^/         /'
      ;;
    *) warn "Could not check Claude tips: $(printf '%s' "$tips_report" | head -1)" ;;
  esac
else
  warn "claude-tips is not installed, run: claude plugin install claude-tips@claude-tips"
fi
