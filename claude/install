#!/usr/bin/env bash
source "$DIR/utils/index"

info "Setup \033[0;37m[claude]\033[0m"

# this topic syncs agent state through iCloud Drive, which only exists on
# macOS. without this guard the `mkdir` below would happily create a fake
# iCloud tree on a linux box and then *move* the real ~/.claude into it
if ! is_macos; then
  success "No iCloud Drive on $DOTFILES_OS, agent state stays local"
  return 0
fi

mkdir -p "$SYSTEM_DIR"

# keep agent state in iCloud, symlinked into place so both machines share
# settings, memory, skills and hooks; .agents must live next to .claude so
# the relative skill links (../../.agents/skills/...) resolve on any machine
link_icloud_dir () {
  local name="$1"
  local src="$SYSTEM_DIR/$name"
  local dst="$HOME/$name"

  # first machine: move the local directory into iCloud
  if [ ! -d "$src" ] && [ -d "$dst" ] && [ ! -L "$dst" ]; then
    mv "$dst" "$src"
  fi

  if [ ! -d "$src" ]; then
    return 0
  fi

  if [ -L "$dst" ]; then
    if [ "$(readlink "$dst")" == "$src" ]; then
      success "Claude $name already linked"
      return 0
    fi
    # stale link (e.g. the old Mackup location) — repoint it
    rm "$dst"
  elif [ -d "$dst" ]; then
    # keep a backup if a local, non-linked directory exists
    mv "$dst" "$dst.backup"
    info "Existing $name moved to $name.backup"
  fi

  ln -s "$src" "$dst"
  success "Claude $name linked to iCloud"
}

# migration: the divio profile used to be called .claude. Rename it in iCloud
# before anything links it, so a machine still on the old layout converges.
# Both names sit next to .agents, so the relative skill links
# (../../.agents/skills/...) keep resolving across the rename.
if [ -d "$SYSTEM_DIR/.claude" ] && [ ! -d "$SYSTEM_DIR/.claude-divio" ]; then
  mv "$SYSTEM_DIR/.claude" "$SYSTEM_DIR/.claude-divio"
  info "Renamed iCloud .claude to .claude-divio"
fi

link_icloud_dir ".agents"
link_icloud_dir ".claude-divio"
link_icloud_dir ".claude-devguard"

# ~/.claude stays as a compatibility symlink. Claude Code falls back to it
# whenever CLAUDE_CONFIG_DIR is unset, which is every entry point that can't
# see the zsh wrapper: the Zed and VS Code extensions, the desktop app, cron
# and any non-interactive shell. Without it those would each silently start a
# blank profile with no skills, settings or login.
if [ -d "$HOME/.claude-divio" ]; then
  if [ -e "$HOME/.claude" ] && [ ! -L "$HOME/.claude" ]; then
    mv "$HOME/.claude" "$HOME/.claude.backup"
    info "Existing .claude moved to .claude.backup"
  fi
  ln -sfn "$HOME/.claude-divio" "$HOME/.claude"
  success "Claude .claude linked to .claude-divio"
fi

# the devguard profile (CLAUDE_CONFIG_DIR=~/.claude-devguard) has its own
# skills dir, so personal skills from .agents are linked in individually;
# same relative-path trick as .claude/skills — .agents sits next to
# .claude-devguard both in iCloud and locally
if [ -d "$HOME/.agents/skills" ]; then
  mkdir -p "$HOME/.claude-devguard/skills"

  # prune broken links left behind by renames or old machines
  find "$HOME/.claude-devguard/skills" -maxdepth 1 -type l ! -exec test -e {} \; -delete

  for skill in "$HOME/.agents/skills"/*/; do
    name="$(basename "$skill")"
    dst="$HOME/.claude-devguard/skills/$name"
    if [ ! -e "$dst" ]; then
      ln -s "../../.agents/skills/$name" "$dst"
    fi
  done
  success "Claude devguard skills linked"
fi

# ~/.claude.json is rewritten atomically (write + rename), which would
# replace a symlink with a plain file — so it is copied instead:
# restored here when missing, backed up on every update
if [ ! -f "$HOME/.claude.json" ] && [ -f "$SYSTEM_DIR/.claude.json.backup" ]; then
  cp "$SYSTEM_DIR/.claude.json.backup" "$HOME/.claude.json"
  success "Restored .claude.json from iCloud"
fi

# claude-tips is installed from github.com/FinalAngel/claude-tips rather than
# vendored here, so both machines track the published plugin. Personal tips are
# an overlay the plugin appends to its own bundled list — kept in this repo and
# linked into place, so they survive the reinstall that every plugin update
# performs. A tip worth sharing belongs in the plugin repo, not in the overlay.
CLAUDE_TIPS_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/claude-tips"
mkdir -p "$CLAUDE_TIPS_CONFIG"
for f in tips ignore; do
  ln -sfn "$DIR/claude/tips/$f.txt" "$CLAUDE_TIPS_CONFIG/$f.txt"
done
success "Claude tips overlay linked"

# the plugin is per profile, and installing needs the network — so this is
# best-effort and never blocks the rest of the bootstrap
for profile in "$HOME/.claude-divio" "$HOME/.claude-devguard"; do
  [ -d "$profile" ] || continue
  name="$(basename "$profile")"
  if CLAUDE_CONFIG_DIR="$profile" claude plugin list 2>/dev/null | grep -q "claude-tips@claude-tips"; then
    success "Claude tips already installed in $name"
    continue
  fi
  if CLAUDE_CONFIG_DIR="$profile" claude plugin marketplace add FinalAngel/claude-tips >/dev/null 2>&1 &&
     CLAUDE_CONFIG_DIR="$profile" claude plugin install claude-tips@claude-tips >/dev/null 2>&1; then
    success "Claude tips installed in $name"
  else
    warn "Could not install claude-tips in $name, run: claude plugin install claude-tips@claude-tips"
  fi
done

# run updates
source "$DIR/claude/update"
