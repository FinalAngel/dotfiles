#!/usr/bin/env bash
source "$DIR/utils/index"

info "Setup \033[0;37m[claude]\033[0m"

SYSTEM_DIR="$HOME/Library/Mobile Documents/com~apple~CloudDocs/System"
mkdir -p "$SYSTEM_DIR"

# keep agent state in iCloud, symlinked into place so both machines share
# settings, memory, skills and hooks; .agents must live next to .claude so
# the relative skill links (../../.agents/skills/...) resolve on any machine
link_icloud_dir () {
  local name="$1"
  local src="$SYSTEM_DIR/$name"
  local dst="$HOME/$name"

  # first machine: move the local directory into iCloud
  if [ ! -d "$src" ] && [ -d "$dst" ] && [ ! -L "$dst" ]; then
    mv "$dst" "$src"
  fi

  if [ ! -d "$src" ]; then
    return 0
  fi

  if [ -L "$dst" ]; then
    if [ "$(readlink "$dst")" == "$src" ]; then
      success "Claude $name already linked"
      return 0
    fi
    # stale link (e.g. the old Mackup location) — repoint it
    rm "$dst"
  elif [ -d "$dst" ]; then
    # keep a backup if a local, non-linked directory exists
    mv "$dst" "$dst.backup"
    info "Existing $name moved to $name.backup"
  fi

  ln -s "$src" "$dst"
  success "Claude $name linked to iCloud"
}

link_icloud_dir ".agents"
link_icloud_dir ".claude"
link_icloud_dir ".claude-devguard"

# the devguard profile (CLAUDE_CONFIG_DIR=~/.claude-devguard) has its own
# skills dir, so personal skills from .agents are linked in individually;
# same relative-path trick as .claude/skills — .agents sits next to
# .claude-devguard both in iCloud and locally
if [ -d "$HOME/.agents/skills" ]; then
  mkdir -p "$HOME/.claude-devguard/skills"

  # prune broken links left behind by renames or old machines
  find "$HOME/.claude-devguard/skills" -maxdepth 1 -type l ! -exec test -e {} \; -delete

  for skill in "$HOME/.agents/skills"/*/; do
    name="$(basename "$skill")"
    dst="$HOME/.claude-devguard/skills/$name"
    if [ ! -e "$dst" ]; then
      ln -s "../../.agents/skills/$name" "$dst"
    fi
  done
  success "Claude devguard skills linked"
fi

# ~/.claude.json is rewritten atomically (write + rename), which would
# replace a symlink with a plain file — so it is copied instead:
# restored here when missing, backed up on every update
if [ ! -f "$HOME/.claude.json" ] && [ -f "$SYSTEM_DIR/.claude.json.backup" ]; then
  cp "$SYSTEM_DIR/.claude.json.backup" "$HOME/.claude.json"
  success "Restored .claude.json from iCloud"
fi

# run updates
source "$DIR/claude/update"
