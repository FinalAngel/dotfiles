+#[test]
+fn full_sync_ignores_stored_filter_when_header_hidden() {
+    let mut g = make_global();
+
+    // `@sidebar_header off` hides the filter bar, so a stored filter can
+    // neither be seen nor clicked back — honouring it would silently empty
+    // the sidebar, and keep doing so for every sidebar started afterwards.
+    let opts = make_opts(&[
+        (tmux::SIDEBAR_FILTER, "error"),
+        (tmux::SIDEBAR_HEADER, "off"),
+    ]);
+    g.apply_all(&opts);
+
+    assert_eq!(g.status_filter, StatusFilter::All);
+}
+
+#[test]
+fn full_sync_applies_stored_filter_when_header_visible() {
+    let mut g = make_global();
+
+    let opts = make_opts(&[
+        (tmux::SIDEBAR_FILTER, "error"),
+        (tmux::SIDEBAR_HEADER, "on"),
+    ]);
+    g.apply_all(&opts);
+
+    assert_eq!(g.status_filter, StatusFilter::Error);
+}
