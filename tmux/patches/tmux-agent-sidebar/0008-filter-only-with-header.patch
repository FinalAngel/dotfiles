     /// Apply all global options from tmux (filter, cursor, repo filter).
     pub fn apply_all(&mut self, opts: &HashMap<String, String>) {
+        // `@sidebar_filter` is only honoured while the filter bar is rendered.
+        // With `@sidebar_header off` there is nothing to show which filter is
+        // active and nothing to click to change it, so a stored non-`all` value
+        // is unrecoverable by eye: it empties the sidebar with no visible cause,
+        // and — because the value persists globally — every sidebar started
+        // afterwards comes up empty too. Keyboard and mouse cycling are already
+        // disabled in that mode; this stops a value stored *before* then from
+        // outliving it.
+        let header_enabled = crate::ui::header_enabled_from_options(opts);
         if let Some(filter_str) = opts.get(tmux::SIDEBAR_FILTER) {
-            let tmux_filter = StatusFilter::from_label(filter_str);
+            let tmux_filter = if header_enabled {
+                StatusFilter::from_label(filter_str)
+            } else {
+                StatusFilter::All
+            };
             if tmux_filter != self.last_saved_filter {
                 self.status_filter = tmux_filter;
                 self.last_saved_filter = tmux_filter;
