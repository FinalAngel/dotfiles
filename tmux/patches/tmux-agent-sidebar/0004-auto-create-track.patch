+/// Last explicit user intent about sidebar visibility, written by the
+/// `toggle` / `toggle-all` subcommands. Read by `toggle --create-only`
+/// when `@sidebar_auto_create` is `track`, so a new window follows the
+/// state the user last chose instead of always opening a sidebar.
+/// Unset is treated as enabled.
+pub const SIDEBAR_ENABLED: &str = "@sidebar_enabled";
+pub const SIDEBAR_AUTO_CREATE: &str = "@sidebar_auto_create";
 pub const SIDEBAR_PET: &str = "@sidebar_pet";
 pub const SIDEBAR_NOTIFICATIONS: &str = "@sidebar_notifications";
