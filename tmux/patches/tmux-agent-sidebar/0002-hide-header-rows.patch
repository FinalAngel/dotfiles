+/// Read `@sidebar_header` from tmux global options, defaulting to `true` (on).
+/// Accepts `on`/`off`, `true`/`false`, `1`/`0` (case-insensitive). When off,
+/// the status filter bar and the repo/notices row are not rendered and the
+/// agent list occupies the full sidebar height.
+pub fn header_enabled_from_options(opts: &HashMap<String, String>) -> bool {
+    opts.get(tmux::SIDEBAR_HEADER)
+        .map(|s| s.trim().to_ascii_lowercase())
+        .map(|s| !matches!(s.as_str(), "off" | "false" | "0" | "no"))
+        .unwrap_or(true)
+}
+
+pub fn header_enabled_from_tmux() -> bool {
+    let opts = crate::tmux::get_all_global_options();
+    header_enabled_from_options(&opts)
+}
