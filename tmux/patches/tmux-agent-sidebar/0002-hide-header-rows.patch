+#[test]
+fn row_zero_click_hits_the_agent_list_when_header_disabled() {
+    // With the header hidden, row 0 is a list line rather than the status
+    // filter bar, so a click there must not toggle the status filter.
+    let pane = make_pane(AgentType::Claude, PaneStatus::Idle);
+    let mut state = make_state(vec![]);
+    state.repo_groups = vec![make_repo_group("project", vec![pane])];
+    state.header_enabled = false;
+    state.rebuild_row_targets();
+    let before = state.global.status_filter;
+
+    state.handle_mouse_click(0, 0);
+
+    assert_eq!(
+        state.global.status_filter, before,
+        "row 0 must not be routed to the filter bar when the header is hidden"
+    );
+    assert!(
+        !state.is_notices_popup_open(),
+        "row 1 routing must not fire either"
+    );
