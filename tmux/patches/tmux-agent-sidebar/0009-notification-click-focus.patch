+/// Bundle identifier to activate on click. An explicit `@sidebar_notification_activate`
+/// wins; empty or `off`/`none` disables activation (matching `parse_sound`, so
+/// the two notification options behave the same way); when the option is unset
+/// entirely, fall back to the inherited `$__CFBundleIdentifier`. Values that are
+/// not plausible bundle identifiers are dropped rather than passed on — the
+/// result is interpolated into a shell command for `terminal-notifier -execute`.
+fn parse_activate(configured: Option<&str>, inherited: Option<&str>) -> Option<String> {
+    let raw = match configured.map(str::trim) {
+        Some(v)
+            if v.is_empty() || v.eq_ignore_ascii_case("off") || v.eq_ignore_ascii_case("none") =>
+        {
+            return None;
+        }
+        Some(v) => v,
+        None => inherited?.trim(),
+    };
+    if raw.is_empty() || !raw.chars().all(is_shell_safe_char) {
+        return None;
+    }
+    Some(raw.to_string())
+}
+
+/// Characters allowed in values interpolated into the click command. Bundle
+/// identifiers and tmux pane ids only ever use these, so anything else means
+/// the value is not what we think it is and must not reach a shell.
+fn is_shell_safe_char(c: char) -> bool {
+    c.is_ascii_alphanumeric() || matches!(c, '.' | '_' | '-' | '%')
+}
+
+/// Shell command `terminal-notifier` runs when the banner is clicked.
+///
+/// `switch-client -t` accepts a pane target — the tmux manual: "As a special
+/// case, -t may refer to a pane (a target that contains ':', '.' or '%'), to
+/// change session, window and pane." So one command moves the attached client
+/// all the way to the pane that raised the notification, wherever it lives.
+///
+/// The terminal is activated after the switch so it comes forward already
+/// showing the right pane.
+/// `tmux_bin` must be absolute. terminal-notifier runs `-execute` from its own
+/// app context, whose PATH is the bare `/usr/bin:/bin:/usr/sbin:/sbin` — a
+/// Homebrew tmux in `/opt/homebrew/bin` is not on it, so a bare `tmux` is
+/// "command not found" and the click silently does nothing. Same reason `open`
+/// is spelled out, even though `/usr/bin` happens to be on that PATH.
+#[cfg(target_os = "macos")]
+fn focus_command(tmux_bin: &str, pane_id: &str, activate: Option<&str>) -> Option<String> {
+    if pane_id.is_empty() || !pane_id.chars().all(is_shell_safe_char) {
+        return None;
+    }
+    if tmux_bin.is_empty() || tmux_bin.contains('\'') {
+        return None;
+    }
+    let mut cmd = format!("'{tmux_bin}' switch-client -t {pane_id}");
+    if let Some(bundle) = activate {
+        cmd.push_str(&format!("; /usr/bin/open -b {bundle}"));
+    }
+    Some(cmd)
+}
+
+/// Absolute path of `name` from the hook process's own PATH, which — unlike the
+/// one `-execute` inherits — is the user's. Falls back to the bare name so a
+/// lookup failure degrades to the previous behaviour rather than to no command.
+#[cfg(target_os = "macos")]
+fn resolve_in_path(name: &str) -> String {
+    use std::os::unix::fs::PermissionsExt;
+
+    std::env::var_os("PATH")
+        .map(|paths| {
+            std::env::split_paths(&paths)
+                .map(|dir| dir.join(name))
+                .find(|candidate| {
+                    std::fs::metadata(candidate)
+                        .map(|m| m.is_file() && m.permissions().mode() & 0o111 != 0)
+                        .unwrap_or(false)
+                })
+        })
+        .unwrap_or(None)
+        .and_then(|p| p.to_str().map(str::to_string))
+        .unwrap_or_else(|| name.to_string())
+}
