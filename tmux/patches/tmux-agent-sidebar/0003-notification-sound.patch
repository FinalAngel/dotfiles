+/// `None` (silent) when unset, empty, or an explicit `off`/`none`. Anything
+/// else is taken as a sound name verbatim; an unknown name simply produces a
+/// silent notification rather than an error, so typos degrade gracefully.
+fn parse_sound(raw: Option<&str>) -> Option<String> {
+    let value = raw?.trim();
+    if value.is_empty() || value.eq_ignore_ascii_case("off") || value.eq_ignore_ascii_case("none") {
+        return None;
+    }
+    Some(value.to_string())
+}
