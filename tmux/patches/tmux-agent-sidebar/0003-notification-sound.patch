+    #[test]
+    fn sound_is_none_by_default_and_for_off_values() {
+        assert_eq!(parse_sound(None), None);
+        assert_eq!(parse_sound(Some("")), None);
+        assert_eq!(parse_sound(Some("   ")), None);
+        assert_eq!(parse_sound(Some("off")), None);
+        assert_eq!(parse_sound(Some("OFF")), None);
+        assert_eq!(parse_sound(Some("none")), None);
+    }
+
+    #[test]
+    fn sound_name_is_taken_verbatim_and_trimmed() {
+        assert_eq!(parse_sound(Some("Glass")), Some("Glass".to_string()));
+        assert_eq!(
+            parse_sound(Some("  Submarine  ")),
+            Some("Submarine".to_string())
+        );
+    }
+
+    #[test]
+    fn settings_read_sound_from_tmux_option() {
+        let mut opts = HashMap::new();
+        opts.insert(tmux::SIDEBAR_NOTIFICATION_SOUND.into(), "Glass".into());
+        let settings = DesktopNotificationSettings::from_tmux_options_with_backend(&opts, true);
+        assert_eq!(settings.sound.as_deref(), Some("Glass"));
+
+        let silent =
+            DesktopNotificationSettings::from_tmux_options_with_backend(&HashMap::new(), true);
+        assert_eq!(silent.sound, None, "silent unless explicitly configured");
+    }
